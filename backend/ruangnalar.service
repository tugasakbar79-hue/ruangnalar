[Unit]
Description=Ruang Nalar AI Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ruangnalar/backend
Environment=PATH=/home/ubuntu/.venv-ruangnalar/bin:/usr/bin
ExecStart=/home/ubuntu/.venv-ruangnalar/bin/python3 /home/ubuntu/ruangnalar/backend/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target